        +Task<OrganizationMembership> GetByUserAndOrganizationAsync(Guid userId, Guid organizationId)
        +Task AddAsync(OrganizationMembership entity)
        +Task UpdateAsync(OrganizationMembership entity)
        +Task DeleteAsync(Guid id)
    }

