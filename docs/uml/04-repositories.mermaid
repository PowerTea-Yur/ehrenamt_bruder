        +VolunteerRepository(AppDbContext)
        +Task<VolunteerProfile> GetByIdAsync(Guid id)
        +Task<List<VolunteerProfile>> GetAllAsync()
        +Task AddAsync(VolunteerProfile entity)
        +Task UpdateAsync(VolunteerProfile entity)
