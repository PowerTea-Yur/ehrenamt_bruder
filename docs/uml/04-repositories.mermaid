    %% ===================== DATABASE CONTEXT =====================
    class AppDbContext {
        <<dbContext>>
        +DbSet<VolunteerProfile> VolunteerProfiles
        +DbSet<Organization> Organizations
        +DbSet<OrganizationMembership> OrganizationMemberships
        +DbSet<Event> Events
        +DbSet<EventSeries> EventSeries
        +DbSet<EventOccurrence> EventOccurrences
        +DbSet<ShiftTemplate> ShiftTemplates
        +DbSet<Shift> Shifts
        +DbSet<ShiftSlot> ShiftSlots
        +DbSet<Registration> Registrations
        +DbSet<WaitlistEntry> WaitlistEntries
        +DbSet<VolunteerSkill> VolunteerSkills
        +DbSet<VolunteerCertification> VolunteerCertifications
        +DbSet<Availability> Availabilities
        +DbSet<Skill> Skills
        +DbSet<Certification> Certifications
        +DbSet<AttendanceRecord> AttendanceRecords
        +DbSet<ShiftTemplateSkill> ShiftTemplateSkills
        +DbSet<ShiftTemplateCertification> ShiftTemplateCertifications
        +Task SaveChangesAsync()
        +void OnModelCreating(ModelBuilder)
    }

    %% ===================== RELATIONSHIPS =====================
    IVolunteerRepository <|.. VolunteerRepository : implements
    IOrganizationRepository <|.. OrganizationRepository : implements
    IOrganizationMembershipRepository <|.. OrganizationMembershipRepository : implements
    IEventRepository <|.. EventRepository : implements
    IEventSeriesRepository <|.. EventSeriesRepository : implements
    IEventOccurrenceRepository <|.. EventOccurrenceRepository : implements
    IShiftTemplateRepository <|.. ShiftTemplateRepository : implements
    IShiftRepository <|.. ShiftRepository : implements
    IShiftSlotRepository <|.. ShiftSlotRepository : implements
    IRegistrationRepository <|.. RegistrationRepository : implements
    IWaitlistRepository <|.. WaitlistRepository : implements
    IVolunteerSkillRepository <|.. VolunteerSkillRepository : implements
    IVolunteerCertificationRepository <|.. VolunteerCertificationRepository : implements
    IAvailabilityRepository <|.. AvailabilityRepository : implements
    ISkillRepository <|.. SkillRepository : implements
    ICertificationRepository <|.. CertificationRepository : implements
    IAttendanceRecordRepository <|.. AttendanceRecordRepository : implements
    IUnitOfWork <|.. UnitOfWork : implements

    VolunteerRepository ..> AppDbContext : uses
    OrganizationRepository ..> AppDbContext : uses
    OrganizationMembershipRepository ..> AppDbContext : uses
    EventRepository ..> AppDbContext : uses
    EventSeriesRepository ..> AppDbContext : uses
    EventOccurrenceRepository ..> AppDbContext : uses
    ShiftTemplateRepository ..> AppDbContext : uses
    ShiftRepository ..> AppDbContext : uses
    ShiftSlotRepository ..> AppDbContext : uses
    RegistrationRepository ..> AppDbContext : uses
    WaitlistRepository ..> AppDbContext : uses
    VolunteerSkillRepository ..> AppDbContext : uses
    VolunteerCertificationRepository ..> AppDbContext : uses
    AvailabilityRepository ..> AppDbContext : uses
    SkillRepository ..> AppDbContext : uses
    CertificationRepository ..> AppDbContext : uses
    AttendanceRecordRepository ..> AppDbContext : uses
    UnitOfWork ..> AppDbContext : uses