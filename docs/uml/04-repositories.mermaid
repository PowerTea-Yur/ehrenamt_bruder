classDiagram
    direction TB

    %% ===================== REPOSITORY INTERFACES =====================
    class IVolunteerRepository {
        <<interface>>
        +Task<VolunteerProfile> GetByIdAsync(Guid id)
        +Task<List<VolunteerProfile>> GetAllAsync()
        +Task AddAsync(VolunteerProfile entity)
        +Task UpdateAsync(VolunteerProfile entity)
        +Task DeleteAsync(Guid id)
        +Task<VolunteerProfile> GetByUserIdAsync(Guid userId)
        +Task<List<VolunteerProfile>> GetByOrganizationAsync(Guid organizationId)
    }

    class IOrganizationRepository {
        <<interface>>
        +Task<Organization> GetByIdAsync(Guid id)
        +Task<List<Organization>> GetAllAsync()
        +Task AddAsync(Organization entity)
        +Task UpdateAsync(Organization entity)
        +Task DeleteAsync(Guid id)
        +Task<Organization> GetByNameAsync(string name)
    }

    class IOrganizationMembershipRepository {
