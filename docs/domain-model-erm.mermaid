erDiagram
    %% ===================== CORE USER & AUTH =====================
    USER ||--o{ ORGANIZATION_MEMBERSHIP : "belongs to"
    USER ||--o| VOLUNTEER_PROFILE : "has"
    USER {
        guid id PK
        string email UK
        string password_hash
        string first_name
        string last_name
        string phone_number
        datetime created_at
        bool is_active
    }

    %% ===================== VOLUNTEER PROFILE =====================
    VOLUNTEER_PROFILE ||--o{ VOLUNTEER_SKILL : "has"
    VOLUNTEER_PROFILE ||--o{ VOLUNTEER_CERTIFICATION : "has"
    VOLUNTEER_PROFILE ||--o{ AVAILABILITY : "has"
    VOLUNTEER_PROFILE ||--o{ REGISTRATION : "makes"
    VOLUNTEER_PROFILE {
        guid id PK,FK
        guid user_id FK
        string bio
        string emergency_contact_name
        string emergency_contact_phone
        date date_of_birth
        guid address_id FK
        datetime created_at
    }

    %% ===================== ORGANIZATION =====================
    ORGANIZATION ||--o{ ORGANIZATION_MEMBERSHIP : "has members"
    ORGANIZATION ||--o{ EVENT : "hosts"
    ORGANIZATION ||--o{ SHIFT_TEMPLATE : "defines"
    ORGANIZATION ||--o{ ADDRESS : "has location"
    ORGANIZATION {
        guid id PK
        string name UK
        string description
        string website
        datetime created_at
        bool is_active
    }

    ORGANIZATION_MEMBERSHIP {
        guid id PK
        guid user_id FK
        guid organization_id FK
        string role "Admin"
        datetime joined_at
    }

    %% ===================== EVENT & SHIFTS =====================
    EVENT ||--o{ SHIFT : "contains"
    EVENT {
        guid id PK
        guid organization_id FK
        string name
        string description
        date start_date
        date end_date
        guid address_id FK
        bool is_recurring
        guid event_series_id FK "nullable"
        datetime created_at
        bool is_published
    }

    SHIFT_TEMPLATE ||--o{ SHIFT : "instantiates"
    SHIFT_TEMPLATE ||--o{ SHIFT_TEMPLATE_SKILL : "requires"
    SHIFT_TEMPLATE ||--o{ SHIFT_TEMPLATE_CERTIFICATION : "requires"
    SHIFT_TEMPLATE {
        guid id PK
        guid organization_id FK
        string name
        string role "e.g., Kitchen, Registration"
        time start_time
        time end_time
        int max_volunteers_per_slot
        datetime created_at
    }

    SHIFT ||--o{ SHIFT_SLOT : "has slots"
    SHIFT {
        guid id PK
        guid event_id FK
        guid shift_template_id FK
        date shift_date
        time start_time "overrides template"
        time end_time "overrides template"
        int max_volunteers "overrides template"
        bool is_cancelled
    }

    SHIFT_SLOT ||--o{ REGISTRATION : "filled by"
    SHIFT_SLOT ||--o{ WAITLIST_ENTRY : "waitlisted for"
    SHIFT_SLOT {
        guid id PK
        guid shift_id FK
        int position "slot number 1..N"
        int max_capacity
        int current_count
        bool is_filled
    }

    %% ===================== REGISTRATION & ATTENDANCE =====================
    REGISTRATION ||--o| ATTENDANCE_RECORD : "has"
    REGISTRATION {
        guid id PK
        guid volunteer_profile_id FK
        guid shift_slot_id FK
        string status "Pending, Confirmed, Cancelled, Attended, NoShow"
        datetime registered_at
        datetime confirmed_at
        datetime cancelled_at
        string cancellation_reason
    }

    ATTENDANCE_RECORD {
        guid id PK
        guid registration_id FK
        datetime checked_in_at
        datetime checked_out_at
        decimal hours_volunteered
        string status "Attended, NoShow, Partial"
        string notes
    }

    WAITLIST_ENTRY {
        guid id PK
        guid volunteer_profile_id FK
        guid shift_slot_id FK
        int position
        datetime joined_at
        datetime notified_at
        datetime claimed_at
        bool is_active
    }

    %% ===================== SHIFT REQUIREMENTS =====================
    SHIFT_TEMPLATE_SKILL {
        guid id PK
        guid shift_template_id FK
        guid skill_id FK
        bool is_required
    }

    SHIFT_TEMPLATE_CERTIFICATION {
        guid id PK
        guid shift_template_id FK
        guid certification_id FK
        bool is_required
    }

    %% ===================== SKILLS & CERTIFICATIONS =====================
    SKILL ||--o{ VOLUNTEER_SKILL : "linked via"
    SKILL ||--o{ SHIFT_TEMPLATE_SKILL : "required by"
    SKILL {
        guid id PK
        string name UK
        string category
        string description
    }

    VOLUNTEER_SKILL {
        guid id PK
        guid volunteer_profile_id FK
        guid skill_id FK
        string proficiency "Beginner, Intermediate, Expert"
        bool is_verified
        guid verified_by FK "nullable"
        datetime verified_at
    }

    CERTIFICATION ||--o{ VOLUNTEER_CERTIFICATION : "linked via"
    CERTIFICATION ||--o{ SHIFT_TEMPLATE_CERTIFICATION : "required by"
    CERTIFICATION {
        guid id PK
        string name UK
        string issuer
        string description
    }

    VOLUNTEER_CERTIFICATION {
        guid id PK
        guid volunteer_profile_id FK
        guid certification_id FK
        date expiry_date
        string verification_status "Unverified, Verified, Expired, Rejected"
        guid verified_by FK "nullable"
        datetime verified_at
        string certificate_number
        string document_url
    }

    %% ===================== AVAILABILITY =====================
    AVAILABILITY {
        guid id PK
        guid volunteer_profile_id FK
        int day_of_week "0-6, null for specific date"
        date specific_date "nullable"
        time start_time
        time end_time
        string recurrence_type "Weekly, Monthly, OneTime"
        date valid_from
        date valid_until
    }

    %% ===================== RECURRING EVENTS =====================
    EVENT_SERIES ||--o{ EVENT_OCCURRENCE : "generates"
    EVENT_SERIES {
        guid id PK
        guid organization_id FK
        string name
        string description
        string recurrence_rule "cron-like: FREQ=WEEKLY;BYDAY=MO,WE"
        date start_date
        date end_date
        guid address_id FK
        datetime created_at
    }

    EVENT_OCCURRENCE {
        guid id PK
        guid event_series_id FK
        date occurrence_date
        bool is_cancelled
        guid event_id FK "nullable, linked when materialized"
    }

    %% ===================== ADDRESS (Shared) =====================
    ADDRESS {
        guid id PK
        string street
        string city
        string postal_code
        string country
        double latitude
        double longitude
    }